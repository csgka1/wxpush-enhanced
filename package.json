{
    "name": "wxpush",
    "type": "module",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "dev": "vite",
        "format": "$npm_execpath exec prettier --write ./src ./tests vitest.config.ts",
        "format:check": "$npm_execpath exec prettier --check ./src ./tests vitest.config.ts",
        "lint": "$npm_execpath format && $npm_execpath exec eslint .",
        "test": "$npm_execpath exec vitest run",
        "test:watch": "$npm_execpath exec vitest",
        "test:coverage": "$npm_execpath exec vitest run --coverage",
        "prepare": "$npm_execpath cf-typegen",
        "build": "$npm_execpath run lint && $npm_execpath exec vite build",
        "vite-preview": "$npm_execpath run build && vite preview",
        "preview": "$npm_execpath run build && $npm_execpath exec wrangler preview --secrets-file .dev.vars.preview",
        "deploy": "$npm_execpath run build && wrangler deploy",
        "cf-typegen": "wrangler types --env-interface CloudflareBindings",
        "cf-typegen:check": "wrangler types --env-interface CloudflareBindings --check",
        "ci-single-lint": "$npm_execpath format:check && $npm_execpath exec eslint .",
        "ci-single-test": "$npm_execpath exec vitest run",
        "ci-single-build": "$npm_execpath exec vite build"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@cloudflare/vite-plugin": "^1.44.0",
        "@hono/zod-validator": "^0.9.1",
        "@workermailer/smtp": "^0.2.1",
        "hono": "^4.13.16",
        "marked": "^18.1.3",
        "sanitize-html": "^2.18.1",
        "vite": "^8.1.4",
        "vite-ssr-components": "^0.8.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.8.3",
        "@types/node": "^26.6.6",
        "@types/sanitize-html": "^2.16.2",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "@vitest/coverage-istanbul": "^5.1.0",
        "eslint": "^10.14.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "vitest": "^5.1.0",
        "wrangler": "^4.164.0"
    }
}